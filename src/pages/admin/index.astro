---
const adminConfig = '/admin/config.yml';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
    <link href={adminConfig} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script is:inline>
      window.__directBlobUpload = async function (file, token) {
        const response = await fetch('https://blob.vercel-storage.com/upload', {
          method: 'POST',
          headers: {
            'content-type': file.type || 'application/octet-stream',
            'x-api-version': '4',
            authorization: `Bearer ${token.clientToken}`,
          },
          body: file,
        });
        if (!response.ok) throw new Error('Direct upload failed');
        return response.json();
      };
    </script>
  </body>
</html>
