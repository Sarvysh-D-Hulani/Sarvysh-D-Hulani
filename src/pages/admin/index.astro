---
const adminConfig = '/admin/config.yml';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
    <link href={adminConfig} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <header class="project-upload-bar">
      <strong>Project file upload</strong>
      <span>Upload from your computer, then paste the returned URL into the project attachment field.</span>
      <label class="upload-button" for="project-file-input">Choose file</label>
      <input id="project-file-input" type="file" accept="video/*,image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.json,.csv" />
      <progress id="project-upload-progress" max="100" value="0" hidden></progress>
      <output id="project-upload-status" aria-live="polite"></output>
      <button id="project-copy-url" type="button" hidden>Copy URL</button>
    </header>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script type="module" is:inline>
      import { upload } from 'https://esm.sh/@vercel/blob@2.3.1/client';
      const input = document.querySelector('#project-file-input');
      const progress = document.querySelector('#project-upload-progress');
      const status = document.querySelector('#project-upload-status');
      const copy = document.querySelector('#project-copy-url');
      let uploadedUrl = '';
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        status.textContent = `Uploading ${file.name}…`;
        progress.hidden = false;
        progress.value = 0;
        copy.hidden = true;
        try {
          const blob = await upload(`projects/${Date.now()}-${file.name}`, file, {
            access: 'public',
            handleUpload: async (params) => {
              const response = await fetch('/api/blob/upload', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(params),
              });
              if (!response.ok) throw new Error(await response.text());
              return response.json();
            },
            multipart: true,
            onUploadProgress: ({ percentage }) => { progress.value = percentage; },
          });
          uploadedUrl = blob.url;
          status.textContent = `Uploaded: ${blob.pathname}`;
          copy.hidden = false;
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Upload failed.';
        }
      });
      copy.addEventListener('click', async () => {
        if (!uploadedUrl) return;
        await navigator.clipboard.writeText(uploadedUrl);
        status.textContent = 'URL copied. Paste it into the attachment URL field.';
      });
    </script>
    <style>
      .project-upload-bar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; padding: .8rem 1.2rem; background: #172033; color: #f8fafc; font: 14px system-ui, sans-serif; }
      .project-upload-bar span { color: #b9c4d4; font-size: 12px; }
      .upload-button, .project-upload-bar button { cursor: pointer; border: 1px solid #4f8cff; border-radius: 999px; padding: .45rem .85rem; color: #fff; background: #235fc5; }
      .project-upload-bar input { display: none; }
      .project-upload-bar progress { width: 120px; }
      .project-upload-bar output { color: #b9c4d4; font-size: 12px; overflow-wrap: anywhere; }
    </style>
  </body>
</html>
